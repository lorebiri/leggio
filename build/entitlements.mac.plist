<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Permessi minimi per un'app Electron con Hardened Runtime (servono al motore JavaScript V8 e a WebAssembly). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Necessario finché l'app è firmata «ad hoc» (senza certificato Apple) con Hardened Runtime:
       senza, macOS rifiuta di caricare i framework di Electron. Si può togliere con la firma Developer ID. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
